<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AJAZZ-Battery-Setup</AssemblyName>
    <RootNamespace>AjazzBattery.Setup</RootNamespace>
    <ApplicationIcon>..\AjazzBattery\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.3.0</Version>
    <Product>AJAZZ Battery Setup</Product>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AjazzBattery\Theme.cs" Link="Shared\Theme.cs" />
    <Compile Include="..\AjazzBattery\NativeUi.cs" Link="Shared\NativeUi.cs" />
    <Compile Include="..\AjazzBattery\Localization.cs" Link="Shared\Localization.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\AjazzBattery\Strings\*.json" Link="Strings\%(Filename)%(Extension)" WithCulture="false">
      <LogicalName>AjazzBattery.Strings.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\AjazzBattery.exe" LogicalName="payload.exe" />
  </ItemGroup>

</Project>

